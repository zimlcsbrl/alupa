# Copie para .env e preencha. Nunca versione o .env.

# Site — liberar buscadores. Só "true" no ambiente Production da Vercel; local e previews ficam sem.
ALUPA_INDEXAR=false

# Neon — aplicação (pooled, PgBouncer em modo transação; host com "-pooler")
DATABASE_URL=postgresql://USUARIO:SENHA@ep-XXXX-pooler.REGIAO.aws.neon.tech/BANCO?sslmode=require&channel_binding=require
# Neon — migrations, COPY e workers de longa duração (conexão direta, sem "-pooler")
DATABASE_URL_UNPOOLED=postgresql://USUARIO:SENHA@ep-XXXX.REGIAO.aws.neon.tech/BANCO?sslmode=require&channel_binding=require

# Redis (docker compose)
REDIS_URL=redis://localhost:6379

# Armazenamento de objetos (MinIO local no docker compose; R2 em staging/produção)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=alupa-dev
S3_ACCESS_KEY_ID=alupa
S3_SECRET_ACCESS_KEY=alupa-dev-secret

# Coleta PNCP em dev: janela reduzida em dias
PNCP_JANELA_DIAS=90
